{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "job-search-app-frontend",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24.22.0 <25"
    },
    "packageManager": "npm@11.19.1",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "lint": "eslint . --max-warnings=0",
        "typecheck": "vue-tsc --build",
        "test": "vitest",
        "test:run": "vitest run",
        "test:e2e": "playwright test",
        "audit:check": "node scripts/check-npm-audit.mjs"
    },
    "dependencies": {
        "vue": "^3.5.44",
        "vue-router": "^4.6.4"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "1.64.1",
        "@tailwindcss/forms": "^0.5.11",
        "@types/node": "^24.19.2",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vue/test-utils": "^2.5.1",
        "@vue/tsconfig": "^0.9.1",
        "autoprefixer": "^10.6.1",
        "eslint": "^10.13.0",
        "eslint-plugin-vue": "^10.11.1",
        "globals": "^17.13.0",
        "jsdom": "^30.1.3",
        "postcss": "^8.5.31",
        "tailwindcss": "^3.4.19",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.72.0",
        "vite": "^8.3.4",
        "vitest": "^5.0.5",
        "vue-tsc": "^3.3.13"
    }
}
