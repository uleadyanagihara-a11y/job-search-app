{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "job-search-app-frontend",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24.22.0 <25"
    },
    "packageManager": "npm@11.19.1",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "lint": "eslint . --max-warnings=0",
        "typecheck": "vue-tsc --build",
        "test": "vitest",
        "test:run": "vitest run",
        "test:e2e": "playwright test",
        "audit:check": "node scripts/check-npm-audit.mjs"
    },
    "dependencies": {
        "vue": "^3.5.45",
        "vue-router": "^5.5.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "1.64.1",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/vite": "^4.3.5",
        "@types/node": "^24.19.2",
        "@vitejs/plugin-vue": "^6.0.11",
        "@vue/test-utils": "^2.6.0",
        "@vue/tsconfig": "^0.9.1",
        "eslint": "^10.14.0",
        "eslint-plugin-vue": "^10.12.1",
        "globals": "^17.14.0",
        "jsdom": "^31.0.1",
        "tailwindcss": "^4.3.5",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.73.0",
        "vite": "^8.3.8",
        "vitest": "^5.1.1",
        "vue-tsc": "^3.3.14"
    }
}
